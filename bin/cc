#!/usr/bin/env bash
set -euo pipefail

# Ubuntu ホスト側用の入口。切替設定は .env の CC_PROVIDER のみ。
cd "$(dirname "${BASH_SOURCE[0]}")/.."
if [[ ! -f .env ]]; then
  echo 'Missing .env: cp .env.example .env and edit it' >&2
  exit 1
fi

# .env をホスト側で source せず、コンテナ内で起動時に読み込みます。
# docker compose の .env 解釈は PROJECT_DIR などのマウント設定用です。
exec docker compose exec workspace /usr/local/bin/cc-entry "$@"
