# 初回のみ cp .env.example .env して編集してください。
# 共有設定・会話履歴・認証は接続先に関係なく同じものを使います。
COMPOSE_PROJECT_NAME=claude-myproject
PROJECT_DIR=/home/YOUR_USER/workspaces/my-project
PERSONAL_DIR=/home/YOUR_USER/claude/claude-personal
USER_UID=1000  # id -u
USER_GID=1000  # id -g
TZ=Asia/Tokyo

# ★ Claude Code の接続先はこの1行だけで切り替えます。
# subscription = Claude Pro / Max 等のサブスク
# bedrock      = Amazon Bedrock
CC_PROVIDER=subscription

# 両方の接続先で使うデフォルトモデル
CC_MODEL=sonnet

# Bedrock 利用時のみ参照されます（プロバイダーの切替設定ではありません）。
AWS_PROFILE=bedrock
AWS_REGION=ap-northeast-1
